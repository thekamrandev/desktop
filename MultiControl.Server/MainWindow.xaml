<Window x:Class="MultiControl.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiControl.Server"
        mc:Ignorable="d"
        Title="MultiControl Server" Height="450" Width="800"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="MultiControl Server" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="btnStartStop" Content="Start Server" Click="btnStartStop_Click" Margin="20,0,0,0" Padding="10,5" />
            <ComboBox x:Name="cmbControlMode" SelectionChanged="cmbControlMode_SelectionChanged" Margin="10,0,0,0" Width="150">
                <ComboBoxItem Content="Individual Control" IsSelected="True" />
                <ComboBoxItem Content="Simultaneous Control" />
            </ComboBox>
        </StackPanel>
        
        <!-- Client List -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Connected Clients -->
            <GroupBox Grid.Column="0" Header="Connected Clients" Margin="0,0,5,0">
                <ListView x:Name="lvConnectedClients" SelectionChanged="lvConnectedClients_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Client Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                            <GridViewColumn Header="IP Address" DisplayMemberBinding="{Binding IpAddress}" Width="120"/>
                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="80"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
            
            <!-- Client Details -->
            <GroupBox Grid.Column="1" Header="Client Details" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Client Name:" Margin="5" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtClientName" Text="" Margin="5"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="IP Address:" Margin="5" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtClientIp" Text="" Margin="5"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Screen Size:" Margin="5" FontWeight="Bold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtClientScreenSize" Text="" Margin="5"/>
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Status:" Margin="5" FontWeight="Bold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtClientStatus" Text="" Margin="5"/>
                    
                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                        <Button x:Name="btnConnectClient" Content="Connect" Click="btnConnectClient_Click" Width="100" Margin="5" IsEnabled="False"/>
                        <Button x:Name="btnDisconnectClient" Content="Disconnect" Click="btnDisconnectClient_Click" Width="100" Margin="5" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Server not running" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>